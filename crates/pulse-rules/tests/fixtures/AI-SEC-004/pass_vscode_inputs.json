{
  "inputs": [
    { "type": "promptString", "id": "jira-token", "description": "Jira token", "password": true }
  ],
  "servers": {
    "jira": {
      "type": "http",
      "url": "https://jira.example.com/mcp",
      "headers": { "Authorization": "Bearer ${input:jira-token}", "X-Region": "eu-west-1" }
    }
  }
}
