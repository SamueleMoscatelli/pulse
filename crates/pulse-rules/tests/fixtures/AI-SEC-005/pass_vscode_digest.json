{
  "inputs": [{ "type": "promptString", "id": "gh-token", "password": true }],
  "servers": {
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server@sha256:3f1c2e5b7a9d"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:gh-token}" }
    },
    "time": { "command": "docker", "args": ["run", "-i", "--rm", "mcp/time:1.0.0"] }
  }
}
